{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agents.dev/schemas/agent.schema.json",
  "title": "Universal Agent",
  "type": "object",
  "required": ["id", "name", "category", "version", "description", "compatible", "outputs", "quality"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+[a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 3 },
    "zh_name": { "type": "string" },
    "category": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string", "minLength": 20 },
    "zh_description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "compatible": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "quality": {
      "type": "object",
      "required": ["checklist"],
      "properties": {
        "checklist": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
      }
    }
  }
}
