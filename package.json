{
  "name": "lazy-agent-shelf",
  "version": "0.1.1",
  "description": "Cross-tool open agent and skill library with generators for Claude, Codex, Cursor, OpenCode, VSCode, and Trae.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint:agents": "node packages/cli/bin/lazy-agent-shelf.js lint",
    "build:agents": "node packages/cli/bin/lazy-agent-shelf.js build --out generated",
    "catalog": "node packages/cli/bin/lazy-agent-shelf.js catalog --out packages/website/src/catalog.json",
    "list": "node packages/cli/bin/lazy-agent-shelf.js list",
    "website:dev": "vite --host 127.0.0.1 --port 5173 packages/website",
    "website:build": "vite build packages/website --config packages/website/vite.config.js --outDir ../../dist/website --emptyOutDir"
  },
  "bin": {
    "lazy-agent-shelf": "packages/cli/bin/lazy-agent-shelf.js",
    "universal-agents": "packages/cli/bin/lazy-agent-shelf.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
